# Local development template. Copy to .env, then run: php artisan key:generate
# Live values live in .env.production.example (never commit real secrets).
APP_NAME="EbizEarn"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8013
FRONTEND_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5174

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ebizearn
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Real email providers are configured in Super Admin > Email. Without an active one, emails go to the log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@ebizearn.com"
MAIL_FROM_NAME="${APP_NAME}"

# PRODUCTION — REQUIRED for signup: all email (signup OTP, verify link,
# notifications) is sent through the Brevo HTTP API with this key. No SMTP.
# Signup FAILS LOUDLY (503, no account created) when mail cannot be delivered.
# The server IP must be allowed in Brevo > Security > Authorised IPs.
BREVO_API_KEY=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

# Withdrawal minimum in cents (master spec: $50.00 = 5000). Single source of truth: config/payouts.php.
WITHDRAWAL_MIN_CENTS=5000

# Sanctum API token lifetime in minutes (7 days default). Bounds the old never-expires finding.
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080

# AI verification provider for the submission pre-check:
#   "auto"   — real AI (OpenAI / Gemini set in Admin → Settings → AI) reads the
#              screenshot right after submit; falls back to manual when no AI is set up
#   "mock"   — heuristic placeholder, labelled simulated (tests / demos)
#   "manual" — no AI, every submission goes to human review
# Single source of truth: config/verification.php.
AI_VERIFICATION_PROVIDER=auto

# Instagram post tasks (official Instagram API + AI). Super Admin enters the
# Instagram app ID / secret in Admin → Settings → Social connect.
IG_AUTO_APPROVE=true
IG_REQUIRE_AI=true
IG_MIN_AI_CONFIDENCE=80
IG_MIN_CAPTION_MATCH=60
IG_FINAL_CHECK_RETRY_HOURS=6
IG_FINAL_CHECK_MAX_ATTEMPTS=5
IG_GRAPH_VERSION=v21.0

# ── Round 2: social login (Google / Apple) ──────────────────────────────
# DAWOOD-SIDE ACTION REQUIRED before social login goes live:
#  1. Google Cloud Console → APIs & Services → Credentials → create an
#     OAuth 2.0 Client ID (Web application), add https://ebizearn.com as an
#     authorized JavaScript origin, paste the client ID below.
#  2. Apple Developer → Certificates, Identifiers & Profiles → Identifiers →
#     create a Services ID (e.g. com.ebizearn.signin), paste it below.
# Until real values are set, every social login request fails closed (401).
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
APPLE_CLIENT_ID=YOUR_APPLE_SERVICES_ID
# Reserved for a future authorization-code exchange flow (not needed for
# plain ID-token verification). Keep empty / unset for now.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
