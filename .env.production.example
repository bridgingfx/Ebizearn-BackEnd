APP_NAME="EbizEarn"
APP_ENV=production
APP_KEY=base64:PASTE_YOUR_LIVE_APP_KEY_HERE
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.ebizearn.com
FRONTEND_URL=https://ebizearn.com
CORS_ALLOWED_ORIGINS=https://ebizearn.com,https://www.ebizearn.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ebizearn
DB_USERNAME=ebizuser
DB_PASSWORD="PASTE_LIVE_DB_PASSWORD_HERE"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
CACHE_PREFIX=
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@ebizearn.com"
MAIL_FROM_NAME="${APP_NAME}"
